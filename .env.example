POSTGRES_DB=portal_b2b
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

PGADMIN_DEFAULT_EMAIL=admin@portalb2b.com
PGADMIN_DEFAULT_PASSWORD=admin

DB_ADMIN_USER=db_portal_b2b
DB_ADMIN_PASSWORD=senha_db_portal_b2b

APP_DATABASE_USER=svc_portal_b2b
APP_DATABASE_PASSWORD=senha_portal_b2b

DB_SCHEMA=portal_b2b

# DATABASE_URL é usada pelos microsserviços rodando diretamente na VM.
DATABASE_URL=postgresql://svc_portal_b2b:senha_portal_b2b@localhost:5432/portal_b2b
# DATABASE_URL_DOCKER é usada se o microsserviço também rodar em container Docker na mesma rede.
DATABASE_URL_DOCKER=postgresql://svc_portal_b2b:senha_portal_b2b@postgres:5432/portal_b2b

# DATABASE_URL_BANCO é usada pela equipe de banco para criar/alterar tabelas.
DATABASE_URL_BANCO=postgresql://db_portal_b2b:senha_db_portal_b2b@localhost:5432/portal_b2b
DATABASE_URL_BANCO_DOCKER=postgresql://db_portal_b2b:senha_db_portal_b2b@postgres:5432/portal_b2b

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_DOCKER=redpanda:9092

REDPANDA_EXTERNAL_HOST=localhost

GATEWAY_PORT=80
PGADMIN_PORT=5050
KAFKA_UI_PORT=8080
POSTGRES_PORT=5432
REDPANDA_PORT=9092

USUARIOS_PORT=5001
PRODUTOS_PORT=5002
FORNECIMENTOS_PORT=5003
DEMANDA_PORT=5004
MERCADO_PORT=5005
NEGOCIACAO_PORT=5006
PEDIDOS_PORT=5007
LOGISTICA_PORT=5008
TRANSPORTADORAS_PORT=5009
