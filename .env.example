# O PostgreSQL local foi removido.
# O banco oficial é o Cloud SQL em 136.114.235.212.
# Não usar postgres:5432 nem localhost:5432 para banco em ambiente de integração.

PGADMIN_DEFAULT_EMAIL=admin@portalb2b.com
PGADMIN_DEFAULT_PASSWORD=admin

DB_ADMIN_USER=db_portal_b2b
DB_ADMIN_PASSWORD=senha_db_portal_b2b

APP_DATABASE_USER=svc_portal_b2b
APP_DATABASE_PASSWORD=senha_portal_b2b

DB_SCHEMA=portal_b2b

DATABASE_URL=postgresql://svc_portal_b2b:senha_portal_b2b@136.114.235.212:5432/portal_b2b
DATABASE_URL_BANCO=postgresql://db_portal_b2b:senha_db_portal_b2b@136.114.235.212:5432/portal_b2b

# Cluster Kafka/Redpanda oficial.
# Usar IPs internos das VMs na VPC.
# Substituir pelos IPs internos reais ao configurar.
KAFKA_BOOTSTRAP_SERVERS=10.128.0.2:9092,10.128.0.3:9092,10.128.0.4:9092

# Apenas para desenvolvimento local, se docker-compose --profile local-kafka for usado.
KAFKA_BOOTSTRAP_SERVERS_LOCAL=redpanda:9092

GATEWAY_PORT=80
PGADMIN_PORT=5050
KAFKA_UI_PORT=8080

USUARIOS_PORT=5001
PRODUTOS_PORT=5002
FORNECIMENTOS_PORT=5003
DEMANDA_PORT=5004
MERCADO_PORT=5005
NEGOCIACAO_PORT=5006
PEDIDOS_PORT=5007
LOGISTICA_PORT=5008
# TRANSPORTADORAS_PORT=5009 (legado, integrado a logística)
