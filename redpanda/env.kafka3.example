# Configuração do broker Redpanda na VM dedicada kafka-3 (broker 2)
# Substitua os IPs pelos IPs internos reais das VMs na VPC do GCP.

REDPANDA_NODE_ID=2
REDPANDA_ADVERTISE_IP=IP_INTERNO_VM_KAFKA_3
REDPANDA_BROKER_1=IP_INTERNO_VM_PRINCIPAL
REDPANDA_BROKER_2=IP_INTERNO_VM_STANDBY
REDPANDA_BROKER_3=IP_INTERNO_VM_KAFKA_3
REDPANDA_KAFKA_PORT=9092
REDPANDA_RPC_PORT=33145
REDPANDA_ADMIN_PORT=9644
